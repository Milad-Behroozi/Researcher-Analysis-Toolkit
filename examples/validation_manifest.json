          "value": 0.50635,
          "tolerance": 0.01
        },
        "illustrated_R_squared": {
          "value": 0.9527230923,
          "tolerance": 0.01
        }
      }
    },
    {
      "id": "tauc_experimental",
      "input": "tauc/Tauc_diffuse_reflectance_example.csv",
